# SeQr laptop-bridge secrets — copy to deploy/local/.env and fill.
#   cp deploy/local/.env.local.example deploy/local/.env
# NEVER commit the real .env (deploy/local/.env is gitignored).
#
# Generate strong secrets:
#   openssl rand -hex 32   # -> SECRET_KEY
#   openssl rand -hex 24   # -> DB_PASSWORD

# --- required ---
# ENVIRONMENT=production refuses to boot with this dev value → set a real one.
SECRET_KEY=CHANGE_ME_min_32_hex_chars
# Optional: overrides the compose default (seqr_local). Set for a real demo.
# DB_PASSWORD=CHANGE_ME_strong_db_password

# --- CORS / operator ---
# The frontend origin(s) that call this API, comma-separated, no trailing slash.
# Must be non-localhost in production (that is where your demo frontend lives).
FRONTEND_URL=https://www.seqrlabs.com,https://se-qr-labs.vercel.app
OPERATOR_EMAILS=pokkalilochan@gmail.com

# --- demo instance flags ---
SEED_DEMO_ON_BOOT=true
ALLOW_DEMO_RESEED=true

# --- CI-4 hosted GitHub App (optional; leave off until you register the App) ---
# GITHUB_APP_ENABLED=false
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_FAIL_ON=
