# SeQr Oracle VM — copy to deploy/oracle/.env and fill. NEVER commit the real .env.
#   cp deploy/oracle/.env.oracle.example deploy/oracle/.env
#
# Generate strong secrets on the VM:
#   openssl rand -hex 32   # -> SECRET_KEY
#   openssl rand -hex 24   # -> DB_PASSWORD

# --- required secrets ---
SECRET_KEY=CHANGE_ME_64_hex_chars_min_32
DB_PASSWORD=CHANGE_ME_strong_db_password

# --- CORS / operator ---
# Vercel origin(s), comma-separated, no trailing slash.
FRONTEND_URL=https://www.seqrlabs.com,https://se-qr-labs.vercel.app
# Founder email(s) for admin console (/admin).
OPERATOR_EMAILS=pokkalilochan@gmail.com

# --- demo instance flags (this is the public demo box) ---
SEED_DEMO_ON_BOOT=true
ALLOW_DEMO_RESEED=true

# DATABASE_URL / REDIS_URL / ENVIRONMENT / DEPLOYMENT_MODE / USE_FAKE_REDIS /
# CELERY_ALWAYS_EAGER are set in docker-compose.oracle.yml — do not duplicate here.
