# SeQr Labs On-Premise Deployment
# Copy to .env and fill in values

# Required
SECRET_KEY=change-this-to-a-random-32-char-string
DB_PASSWORD=change-this-database-password
LICENSE_KEY=SQ-MID-your-license-key-here

# License public key (provided by SeQr Labs)
LICENSE_PUBLIC_KEY=

# Optional
DEPLOYMENT_MODE=onprem
ENVIRONMENT=production
FRONTEND_URL=http://localhost:3000
