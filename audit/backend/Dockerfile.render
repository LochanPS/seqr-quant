# Deploy image for the SeQr auth/audit backend.
#
# Build context MUST be the seqr-labs repo root (sibling of shared-scanner/),
# because the scanner is installed from ../../shared-scanner. render.yaml sets
# dockerContext accordingly.
#
# trixie (Debian 13) ships OpenSSL 3.5.x with native ML-KEM hybrid groups,
# required for active PQC detection (scanner/pqc_probe.py); older OpenSSL falls
# back to passive automatically.
FROM python:3.12-slim-trixie

WORKDIR /app

# build-essential + libffi: native wheels. pango/cairo/gdk-pixbuf/fonts: WeasyPrint PDFs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libssl-dev \
    openssl \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Scanner first (changes least → better layer caching).
COPY shared-scanner /app/shared-scanner
COPY audit/backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt \
    && pip install --no-cache-dir /app/shared-scanner

COPY audit/backend /app/backend
WORKDIR /app/backend
RUN mkdir -p reports

# Render injects $PORT. Run migrations, then serve.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
